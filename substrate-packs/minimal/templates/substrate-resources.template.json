        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "mongodb",
      "namespace": "{{NAMESPACE}}",
      "labels": {
        "app.kubernetes.io/managed-by": "agentsmith-release-kit",
        "app.kubernetes.io/part-of": "agentsmith-substrate",
        "app.kubernetes.io/name": "mongodb"
      },
      "annotations": {
        "agentsmith.io/managed-by": "agentsmith-release-kit",
        "agentsmith.io/installation-id": "{{INSTALLATION_ID}}"
      }
    },
    "spec": {
      "serviceName": "mongodb",
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "mongodb"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/part-of": "agentsmith-substrate",
            "app.kubernetes.io/name": "mongodb"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "mongodb",
              "image": "{{IMAGE_MONGODB}}",
              "ports": [
                {
                  "name": "mongodb",
                  "containerPort": 27017
                }
              ],
              "env": [
                {
                  "name": "MONGO_INITDB_ROOT_USERNAME",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "mongodb-app",
                      "key": "username"
                    }
                  }
                },
                {
                  "name": "MONGO_INITDB_ROOT_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "mongodb-app",
                      "key": "password"
                    }
                  }
                }
              ],
              "args": [
                "mongod",
                "--bind_ip_all",
                "--tlsMode",
                "requireTLS",
                "--tlsCertificateKeyFile",
                "/tls/tls.pem",
                "--tlsCAFile",
                "/tls/ca.crt"
              ],
              "volumeMounts": [
                {
                  "name": "mongodb-data",
                  "mountPath": "/data/db"
                },
                {
                  "name": "mongodb-tls",
                  "mountPath": "/tls",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "mongodb-data",
              "persistentVolumeClaim": {
                "claimName": "mongodb-data"
              }
            },
            {
              "name": "mongodb-tls",
              "secret": {
                "secretName": "mongodb-server-tls"
              }
            }
          ]
        }
      }
    }
  },
