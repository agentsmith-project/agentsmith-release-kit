            {
              "name": "oidc",
              "image": "{{IMAGE_OIDC}}",
              "ports": [
                {
                  "name": "https",
                  "containerPort": 8443
                }
              ],
              "env": [
                {
                  "name": "KEYCLOAK_ADMIN",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "oidc-admin",
                      "key": "username"
                    }
                  }
                },
                {
                  "name": "KEYCLOAK_ADMIN_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "oidc-admin",
                      "key": "password"
                    }
                  }
                },
                {
                  "name": "KC_HEALTH_ENABLED",
                  "value": "true"
                }
              ],
              "args": [
                "start-dev",
                "--https-port=8443",
                "--https-certificate-file=/tls/tls.crt",
                "--https-certificate-key-file=/tls/tls.key",
                "--hostname-strict=false"
              ],
              "volumeMounts": [
                {
                  "name": "oidc-tls",
                  "mountPath": "/tls",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "oidc-tls",
              "secret": {
                "secretName": "oidc-server-tls"
              }
            }
          ]
        }
      }
    }
  }
]
