        "Ingress"
      ],
      "ingress": [
        {
          "from": [
            {
              "namespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "{{JUICEFS_CSI_NAMESPACE}}"
                }
              },
              "podSelector": {
                "matchLabels": {
                  "app.kubernetes.io/name": "juicefs-mount"
                }
              }
            }
          ],
          "ports": [
            {
              "protocol": "TCP",
              "port": 9000
            }
          ]
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "name": "postgresql",
      "namespace": "{{NAMESPACE}}",
      "labels": {
        "app.kubernetes.io/managed-by": "agentsmith-release-kit",
        "app.kubernetes.io/part-of": "agentsmith-substrate",
        "app.kubernetes.io/name": "postgresql"
      },
      "annotations": {
        "agentsmith.io/managed-by": "agentsmith-release-kit",
        "agentsmith.io/installation-id": "{{INSTALLATION_ID}}"
      }
    },
    "spec": {
      "type": "ClusterIP",
      "selector": {
        "app.kubernetes.io/name": "postgresql"
      },
      "ports": [
        {
          "name": "postgresql",
          "port": 5432,
          "targetPort": 5432
        }
      ]
    }
  },
  {
    "apiVersion": "v1",
    "kind": "PersistentVolumeClaim",
    "metadata": {
      "name": "postgresql-data",
      "namespace": "{{NAMESPACE}}",
      "labels": {
        "app.kubernetes.io/managed-by": "agentsmith-release-kit",
        "app.kubernetes.io/part-of": "agentsmith-substrate",
        "app.kubernetes.io/name": "postgresql"
      },
      "annotations": {
        "agentsmith.io/managed-by": "agentsmith-release-kit",
        "agentsmith.io/installation-id": "{{INSTALLATION_ID}}"
      }
    },
    "spec": {
      "accessModes": [
        "ReadWriteOnce"
      ],
      "storageClassName": "{{STORAGE_CLASS}}",
      "resources": {
        "requests": {
          "storage": "20Gi"
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "postgresql",
      "namespace": "{{NAMESPACE}}",
      "labels": {
        "app.kubernetes.io/managed-by": "agentsmith-release-kit",
        "app.kubernetes.io/part-of": "agentsmith-substrate",
        "app.kubernetes.io/name": "postgresql"
      },
      "annotations": {
        "agentsmith.io/managed-by": "agentsmith-release-kit",
        "agentsmith.io/installation-id": "{{INSTALLATION_ID}}"
      }
    },
    "spec": {
      "serviceName": "postgresql",
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "postgresql"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/part-of": "agentsmith-substrate",
            "app.kubernetes.io/name": "postgresql"
          }
        },
        "spec": {
          "initContainers": [
            {
              "name": "postgresql-prepare-tls",
              "image": "{{IMAGE_POSTGRESQL}}",
              "command": [
                "sh",
                "-ec",
                "cp /tls-source/tls.crt /tls/tls.crt\ncp /tls-source/tls.key /tls/tls.key\ncp /tls-source/ca.crt /tls/ca.crt\nchown postgres:postgres /tls/tls.crt /tls/tls.key /tls/ca.crt\nchmod 0644 /tls/tls.crt /tls/ca.crt\nchmod 0600 /tls/tls.key"
              ],
              "volumeMounts": [
                {
                  "name": "postgresql-tls-workdir",
                  "mountPath": "/tls"
                },
                {
                  "name": "postgresql-tls-source",
                  "mountPath": "/tls-source",
                  "readOnly": true
                }
              ]
            }
          ],
          "containers": [
            {
              "name": "postgresql",
              "image": "{{IMAGE_POSTGRESQL}}",
              "ports": [
                {
                  "name": "postgresql",
                  "containerPort": 5432
                }
              ],
              "env": [
                {
                  "name": "POSTGRES_DB",
                  "value": "agentsmith"
                },
                {
                  "name": "POSTGRES_USER",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "postgresql-app",
                      "key": "username"
                    }
                  }
                },
                {
                  "name": "POSTGRES_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "postgresql-app",
                      "key": "password"
                    }
                  }
                },
                {
                  "name": "PGDATA",
                  "value": "/pgdata"
                }
              ],
              "args": [
                "postgres",
                "-c",
                "ssl=on",
                "-c",
                "ssl_cert_file=/tls/tls.crt",
                "-c",
                "ssl_key_file=/tls/tls.key",
                "-c",
                "ssl_ca_file=/tls/ca.crt"
              ],
              "volumeMounts": [
                {
                  "name": "postgresql-data",
                  "mountPath": "/pgdata"
                },
                {
                  "name": "postgresql-tls-workdir",
                  "mountPath": "/tls",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "postgresql-data",
              "persistentVolumeClaim": {
                "claimName": "postgresql-data"
              }
            },
            {
              "name": "postgresql-tls-workdir",
              "emptyDir": {}
            },
            {
              "name": "postgresql-tls-source",
              "secret": {
                "secretName": "postgresql-server-tls"
              }
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "v1",
    "kind": "Service",
