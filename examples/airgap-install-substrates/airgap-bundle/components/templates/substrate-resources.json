    },
    "spec": {
      "serviceName": "mongodb",
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "mongodb"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/part-of": "agentsmith-substrate",
            "app.kubernetes.io/name": "mongodb"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "mongodb",
              "image": "registry.airgap.example/agentsmith/substrates/mongodb:7.0@sha256:948b635bc126d62274eebb650dd2e2e66c9abc3bb0a336eb2279a5d8489417f5",
              "ports": [
                {
                  "name": "mongodb",
                  "containerPort": 27017
                }
              ],
              "env": [
                {
                  "name": "MONGO_INITDB_ROOT_USERNAME",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "mongodb-app",
                      "key": "username"
                    }
                  }
                },
                {
                  "name": "MONGO_INITDB_ROOT_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "mongodb-app",
                      "key": "password"
                    }
                  }
                }
              ],
              "args": [
                "mongod",
                "--bind_ip_all",
                "--tlsMode",
                "requireTLS",
                "--tlsCertificateKeyFile",
                "/tls/tls.pem",
                "--tlsCAFile",
                "/tls/ca.crt"
              ],
              "volumeMounts": [
                {
                  "name": "mongodb-data",
                  "mountPath": "/data/db"
                },
                {
                  "name": "mongodb-tls",
                  "mountPath": "/tls",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "mongodb-data",
              "persistentVolumeClaim": {
                "claimName": "mongodb-data"
              }
            },
            {
              "name": "mongodb-tls",
              "secret": {
                "secretName": "mongodb-server-tls"
              }
            }
          ]
        }
