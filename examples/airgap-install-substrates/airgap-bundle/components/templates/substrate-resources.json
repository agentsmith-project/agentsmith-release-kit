  {
    "apiVersion": "apps/v1",
    "kind": "StatefulSet",
    "metadata": {
      "name": "postgresql",
      "namespace": "agentsmith",
      "labels": {
        "app.kubernetes.io/managed-by": "agentsmith-release-kit",
        "app.kubernetes.io/part-of": "agentsmith-substrate",
        "app.kubernetes.io/name": "postgresql"
      },
      "annotations": {
        "agentsmith.io/managed-by": "agentsmith-release-kit",
        "agentsmith.io/installation-id": "kit-install-airgap-20260523-001"
      }
    },
    "spec": {
      "serviceName": "postgresql",
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/name": "postgresql"
        }
      },
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/part-of": "agentsmith-substrate",
            "app.kubernetes.io/name": "postgresql"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "postgresql",
              "image": "registry.airgap.example/agentsmith/substrates/postgresql:pg16@sha256:00ba258a66dac104fd5171074a0084462a64a1369d8513f3d0a634e2f24d15bc",
              "ports": [
                {
                  "name": "postgresql",
                  "containerPort": 5432
                }
              ],
              "env": [
                {
                  "name": "POSTGRES_DB",
                  "value": "agentsmith"
                },
                {
                  "name": "POSTGRES_USER",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "postgresql-app",
                      "key": "username"
                    }
                  }
                },
                {
                  "name": "POSTGRES_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "name": "postgresql-app",
                      "key": "password"
                    }
                  }
                },
                {
                  "name": "PGDATA",
                  "value": "/pgdata"
                }
              ],
              "args": [
                "postgres",
                "-c",
                "ssl=on",
                "-c",
                "ssl_cert_file=/tls/tls.crt",
                "-c",
                "ssl_key_file=/tls/tls.key",
                "-c",
                "ssl_ca_file=/tls/ca.crt"
              ],
              "volumeMounts": [
                {
                  "name": "postgresql-data",
                  "mountPath": "/pgdata"
                },
                {
                  "name": "postgresql-tls",
                  "mountPath": "/tls",
                  "readOnly": true
                }
              ]
            }
          ],
          "volumes": [
            {
              "name": "postgresql-data",
              "persistentVolumeClaim": {
                "claimName": "postgresql-data"
              }
            },
            {
              "name": "postgresql-tls",
              "secret": {
                "secretName": "postgresql-server-tls"
              }
            }
          ]
        }
      }
    }
  },
